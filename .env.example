# Copy to `.env` (git-ignored) and export, or set these in your deployment environment.
# All values are optional; the app runs without any of them (emails are then logged, not sent).

# Flask session signing key. REQUIRED in production (CSRF tokens depend on it).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Where contact-form messages are delivered. Defaults to the email in cv_data.py.
CONTACT_RECIPIENT=you@example.com
CONTACT_SUBJECT_PREFIX=[CV Contact]
# Max submissions per IP within the window (0 disables the limit).
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=3600

# SMTP transport. Leave MAIL_SERVER empty to log emails to the console instead.
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=smtp-user@example.com
MAIL_PASSWORD=
MAIL_USE_TLS=true          # STARTTLS (port 587)
MAIL_USE_SSL=false         # implicit TLS (port 465) - mutually exclusive with MAIL_USE_TLS
MAIL_DEFAULT_SENDER=no-reply@example.com
MAIL_TIMEOUT=10
# Force console logging even when MAIL_SERVER is set (handy in staging).
MAIL_SUPPRESS_SEND=false
# Keep one SMTP session open between sends (reconnects automatically if it goes stale).
MAIL_KEEPALIVE=true

# --- Deployment hardening -------------------------------------------------------
# Set when serving over HTTPS: marks the session cookie Secure and enables HSTS.
SESSION_COOKIE_SECURE=false
HSTS_ENABLED=              # defaults to SESSION_COOKIE_SECURE
HSTS_MAX_AGE=31536000
# Number of reverse proxies in front of the app (nginx, Caddy, a cloud LB…). Their
# X-Forwarded-For/Proto headers are trusted so rate limiting sees real client IPs.
TRUSTED_PROXIES=0
# Browser caching: versioned static assets (1 year) and the JSON API (5 minutes).
STATIC_MAX_AGE=31536000
API_CACHE_MAX_AGE=300

# Path to the downloadable CV PDF (defaults to "Alex Maican - CV.pdf" in the project root).
CV_PDF_PATH=

# Dev server options used by `uv run resumeapp` / `python app.py`.
PORT=5123
FLASK_DEBUG=1

# Start the bundled SMTP server in-process and deliver contact emails to it.
# Received messages are saved as .eml files under DEV_SMTP_MAILDIR.
DEV_SMTP=0
DEV_SMTP_PORT=0            # 0 = pick a free port; or e.g. 1025
DEV_SMTP_MAILDIR=mail-outbox
